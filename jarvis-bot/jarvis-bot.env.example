# Jarvis bot settings. The real file lives at /Users/jarvis/.jarvis-bot.env
# (owner jarvis, mode 600). Never put the real values in a repo, a note or a chat.

# Discord Developer Portal > your Jarvis application > Bot > Reset Token
DISCORD_BOT_TOKEN=paste-the-bot-token-here

# The accounts Jarvis obeys, comma-separated, no spaces (e.g. BDev and epondboys):
# Discord > Settings > Advanced > Developer Mode on, then right-click each name > Copy User ID
OWNER_DISCORD_ID=

# Optional: right-click your private #jarvis channel > Copy Channel ID.
# If empty, Jarvis answers in DMs, and in servers only when you @mention it.
JARVIS_CHANNEL_ID=

# Local AI (must stay on 127.0.0.1)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b

# Morning post time (24-hour, Jarvis's clock)
BRIEFING_TIME=07:30

# Machine to check over Tailscale (SSH port only)
TRADING_HOST=tradingserver

# Optional: a daily briefing file Jarvis may read (the "Needs you" section only)
BRIEFING_FILE=

# Agent tasks (plan / approve). As the jarvis user at the Mac (not sudo), run:  claude setup-token
# and paste the token it prints here. It uses your Claude subscription. Never share it.
CLAUDE_CODE_OAUTH_TOKEN=
